{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:server": "cd server && npm install && npx prisma generate && npm run build",
    "start": "cd server && npm start",
    "dev:frontend": "vite --host",
    "dev:server": "cd server && npm run dev",
    "dev": "concurrently -n \"frontend,server\" -c \"blue,green\" \"npm run dev:frontend\" \"npm run dev:server\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "ecc-universal": "^2.2.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "recharts": "2.15.2",
    "socket.io-client": "^4.8.3",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "4.1.12",
    "vite": "^6.4.1"
  }
}
