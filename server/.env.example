# Server Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_string
CLIENT_ORIGIN=http://localhost:5173
ADMIN_PASSWORD=admin123

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

