# ============================================================
# TTU SmartAttend — Production Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Frontend Configuration (.env)
# ------------------------------------------------------------
# The base URL of the backend API
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Cryptographic secret for signing JWT access tokens and OTP reset session tokens
# Generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# PostgreSQL Database Connection String (e.g. Supabase, AWS RDS, Railway)
DATABASE_URL="postgresql://postgres:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Initial master administrator password
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# Real-World SMS Gateway (Ghana Telecoms: MTN, Telecel, AT)
# ------------------------------------------------------------
# Arkesel SMS Gateway (https://arkesel.com)
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=TTU-ATTEND

# Hubtel Alternative (https://hubtel.com)
# HUBTEL_CLIENT_ID=your_hubtel_client_id
# HUBTEL_CLIENT_SECRET=your_hubtel_client_secret

# ------------------------------------------------------------
# Institutional SMTP Configuration (Email Delivery)
# ------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=smartattend@ttu.edu.gh
# SMTP_PASS=your_app_password
# SMTP_FROM="TTU SmartAttend <smartattend@ttu.edu.gh>"
